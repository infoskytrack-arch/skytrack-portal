# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: Admin password for the SKY TRACK Ticket Upload & Request Management portal.
# Configure in Settings -> Secrets before sharing or deploying.
# If unset on first run, use the inline first-run setup form in the Admin tab.
ADMIN_PASSWORD=
